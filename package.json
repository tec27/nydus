{
  "name": "nydus",
  "version": "5.4.0",
  "description": "WebSocket server using the nydus protocol, a simple RPC/PubSub protocol.",
  "types": "./dist/index.d.mts",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint --ext .js,.ts ./",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "test": "mocha --import=tsx -R spec test/**.ts",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/tec27/nydus"
  },
  "keywords": [
    "nydus",
    "websockets",
    "websocket",
    "rpc",
    "pubsub"
  ],
  "author": "Travis Collins <travis@tec27.com> (http://tec27.com/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tec27/nydus/issues"
  },
  "homepage": "https://github.com/tec27/nydus",
  "files": [
    "dist/**"
  ],
  "dependencies": {
    "backo2": "^1.0.2",
    "engine.io": "^6.6.11",
    "immutable": "^5.1.9",
    "nanoid": "^6.0.1",
    "nydus-protocol": "^3.0.0",
    "ruta3": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/backo2": "^1.0.4",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "engine.io-client": "^6.6.7",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "mocha": "^12.0.2",
    "nydus-client": "^5.4.0",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
